{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/tbot_console/web/static/js/**/*.js",
    "src/tbot_console/web/static/js/**/*.d.ts"
  ],
  "exclude": ["**/vendor/**", "**/*.test.js"]
}
